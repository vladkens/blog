#!/usr/bin/env bash
set -euo pipefail

github_handle="vladkens"
port=2222
listen_address="0.0.0.0"
state_dir="${HOME}/.ssh/local-sshd"
host_key="${state_dir}/ssh_host_ed25519_key"
config_file="${state_dir}/sshd_config"
authorized_keys="${state_dir}/authorized_keys"
launchd_label="local.sshd"
launchd_plist="${HOME}/Library/LaunchAgents/${launchd_label}.plist"
launchd_domain="gui/$(id -u)"
service_user="$(id -un)"

if [[ "$EUID" -eq 0 ]]; then
  echo "Run this installer as your regular macOS user." >&2
  exit 1
fi

if ! command -v brew >/dev/null; then
  echo "Homebrew is required: https://brew.sh" >&2
  exit 1
fi

brew install openssh

openssh_prefix="$(brew --prefix openssh)"
sshd_bin="${openssh_prefix}/sbin/sshd"
ssh_keygen="${openssh_prefix}/bin/ssh-keygen"

if [[ ! -x "$sshd_bin" || ! -x "$ssh_keygen" ]]; then
  echo "Homebrew OpenSSH installation is incomplete." >&2
  exit 1
fi

mkdir -p "$state_dir"
chmod 700 "${HOME}/.ssh" "$state_dir"

if [[ ! -f "$host_key" ]]; then
  "$ssh_keygen" -q -t ed25519 -f "$host_key" -N ''
fi
chmod 600 "$host_key"
chmod 644 "${host_key}.pub"

keys_tmp="$(mktemp "${state_dir}/authorized_keys.XXXXXX")"
plist_tmp="$(mktemp -t "$launchd_label")"
trap 'rm -f "$keys_tmp" "$plist_tmp"' EXIT

/usr/bin/curl -fsSL "https://github.com/${github_handle}.keys" -o "$keys_tmp"
if [[ ! -s "$keys_tmp" ]]; then
  echo "GitHub user has no public SSH keys: ${github_handle}" >&2
  exit 1
fi
if ! "$ssh_keygen" -l -f "$keys_tmp" >/dev/null; then
  echo "GitHub returned invalid SSH keys for: ${github_handle}" >&2
  exit 1
fi
chmod 600 "$keys_tmp"
mv "$keys_tmp" "$authorized_keys"

cat > "$config_file" <<EOF
Port ${port}
ListenAddress ${listen_address}
HostKey ${host_key}
PidFile ${state_dir}/sshd.pid

PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM no
PubkeyAuthentication yes
AuthorizedKeysFile ${authorized_keys}

AllowUsers ${service_user}
AllowTcpForwarding yes
X11Forwarding no
PrintMotd no
Subsystem sftp internal-sftp
EOF
chmod 600 "$config_file"

"$sshd_bin" -t -f "$config_file"

cat > "$plist_tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${launchd_label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${sshd_bin}</string>
    <string>-D</string>
    <string>-e</string>
    <string>-f</string>
    <string>${config_file}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${state_dir}/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>${state_dir}/stderr.log</string>
</dict>
</plist>
EOF

/usr/bin/plutil -lint "$plist_tmp" >/dev/null

echo "Installing ${launchd_label} to ${launchd_plist}"
mkdir -p "$(dirname "$launchd_plist")"
/usr/bin/install -m 0644 "$plist_tmp" "$launchd_plist"

if /bin/launchctl print "${launchd_domain}/${launchd_label}" >/dev/null 2>&1; then
  /bin/launchctl bootout "${launchd_domain}/${launchd_label}"
fi
/bin/launchctl bootstrap "$launchd_domain" "$launchd_plist"

echo "Installed SSH server on ${listen_address}:${port}"
echo "Authorized GitHub keys for: ${github_handle}"
echo "Connect with: ssh -p ${port} ${service_user}@<hostname-or-ip>"
